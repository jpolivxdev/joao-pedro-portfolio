# Copie este arquivo para .env.local e preencha com sua chave real.
# .env.local nunca é commitado (já está no .gitignore).

# Chave de API do Resend (https://resend.com) usada pela rota
# /api/contact para enviar o e-mail do formulário de contato.
# Sem essa variável, o formulário continua funcionando, mas só
# loga a mensagem no console do servidor em vez de enviar de verdade.
RESEND_API_KEY=

# Token do GitHub (https://github.com/settings/tokens, "Fine-grained token"
# sem nenhuma permissão marcada já serve, já que só lê dados públicos) usado
# pra buscar seus repositórios em /lib/github.ts. Opcional em desenvolvimento
# (a API do GitHub libera 60 requisições/hora sem token, o que já basta pra
# testar local), mas recomendado em produção — sem ele, é fácil esbarrar
# nesse limite e os projetos somem do site por até 1 hora (tempo do cache).
GITHUB_TOKEN=
